# ---- Required ----
# Get from @BotFather on Telegram
TELEGRAM_TOKEN=

# Optional: seeds the key pool on first boot. After that, manage keys from
# the in-bot admin panel (/admin -> DeepSeek Accounts).
# Each key/account = one more user who can chat AT THE SAME TIME.
# NEW: Email accounts are preferred — they auto-refresh when token expires!
# You can also set DEEPSEEK_TOKEN for legacy single-token mode.
DEEPSEEK_TOKEN=

# ---- Database (required for multi-user) ----
MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net/?appName=Cluster0
MONGO_DB=deepseek_bot

# Your Telegram numeric user ID (the bot ONLY replies to this ID)
# Get it from @userinfobot on Telegram
OWNER_ID=

# ---- Optional ----
# tiny (~40MB) / base (~140MB) / small (~500MB, best for Hinglish) / medium
WHISPER_SIZE=small

# Set to "1" when running on Render / Fly.io / any host that requires an HTTP port
ENABLE_HEALTH=0

# Port for the health-check server (Render sets this automatically)
PORT=10000

# How many updates to handle at once (1 = old behaviour, buttons block)
CONCURRENCY=8

# Max DeepSeek requests per user inside RATE_WINDOW seconds (0 = unlimited).
# Protects the shared session token from upstream throttling.
RATE_LIMIT=20
RATE_WINDOW=60

# Where to persist chat history (survives restarts, powers /export + Regen)
# Where to persist per-user preferences (JSON file)
# How long a user waits for a free DeepSeek key/account (seconds)
# New queue system: users wait line-by-line FIFO with "Analysing your request..." loader
# Example: 2 accounts = 2 users simultaneously, 3rd user sees queue loader until slot free
KEY_WAIT_TIMEOUT=180

# ---- Single-poller guard ----
# Only one instance may poll Telegram, otherwise you get
# "Conflict: terminated by other getUpdates request" and messages are
# answered intermittently. On boot the bot waits this long for a previous
# deploy to exit before giving up.
LOCK_WAIT=75
# Set to 1 to forcibly take over the lease (use if a crashed instance is
# holding it and you cannot wait for the TTL).
FORCE_POLL=0

# ---- NEW: Email account auto-refresh ----
# Bot now supports adding DeepSeek accounts via EMAIL + PASSWORD from Telegram admin panel.
# No need to manually copy tokens! Go to:
#   /admin -> 🔑 DeepSeek Accounts -> ➕ Add Email Account
# Then send:  email password   (e.g. user@example.com mypass123)
# Or:         label email password
# Bot will login, fetch token, store it, and auto-refresh on expiry.
# Add 10 accounts = 10 users can chat simultaneously.
# Health check runs every 6h and notifies admin on failure.


# ---- YouTube transcript fetching (fix for "YouTube is blocking requests from your IP") ----
# Cloud hosts (Render/AWS/GCP) have IPs that YouTube blocks. urlfetch.py tries
# youtube-transcript-api -> yt-dlp -> Invidious mirrors. If ALL fail, add ONE of these:
# YT_PROXY: any proxy whose exit IP is not a cloud IP (residential/VPN best).
#           Examples: http://user:pass@proxy-host:8080  or  socks5://host:1080
#           (standard HTTPS_PROXY / HTTP_PROXY env vars are also honored)
# YT_PROXY=
# YT_COOKIES: export cookies.txt from a browser signed into YouTube
#             (Netscape format). Accepts: a file path, the raw file content,
#             or base64 of the file. Used by yt-dlp to pass the bot check.
# YT_COOKIES=
# YT_MIRRORS: optional override, comma-separated Invidious bases
# YT_MIRRORS=https://inv.nadeko.net,https://yewtu.be
