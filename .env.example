# ---- Required ----
# Get from @BotFather on Telegram
TELEGRAM_TOKEN=

# Get from browser DevTools while logged into https://chat.deepseek.com
# Application → Local Storage → look for the userToken value
DEEPSEEK_TOKEN=

# Your Telegram numeric user ID (the bot ONLY replies to this ID)
# Get it from @userinfobot on Telegram
OWNER_ID=

# ---- Optional ----
# tiny (~40MB) / base (~140MB) / small (~500MB, best for Hinglish) / medium
WHISPER_SIZE=small

# Set to "1" when running on Render / Fly.io / any host that requires an HTTP port
ENABLE_HEALTH=0

# Port for the health-check server (Render sets this automatically)
PORT=10000

# How many updates to handle at once (1 = old behaviour, buttons block)
CONCURRENCY=8

# Where to persist per-user preferences (JSON file)
STATE_FILE=state.json
